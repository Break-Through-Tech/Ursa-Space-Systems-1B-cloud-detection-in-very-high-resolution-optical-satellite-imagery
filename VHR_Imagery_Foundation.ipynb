    "## 4. Window-Reading Techniques\n",
    "\n",
    "Since VHR images are very large, we'll use window-reading to load specific regions. This is memory-efficient and allows us to explore different parts of the image."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to read a window from the image\n",
    "def read_image_window(url, window_size=1024, offset_x=0, offset_y=0):\n",
    "    \"\"\"\n",
    "    Read a window from a cloud-optimized GeoTIFF\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    url : str\n",
    "        URL to the image file\n",
    "    window_size : int\n",
    "        Size of the window to read (square)\n",
    "    offset_x, offset_y : int\n",
    "        Offset from the top-left corner\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    numpy array, profile dict\n",
    "    \"\"\"\n",
    "    with rasterio.open(url) as src:\n",
    "        # Create a window\n",
    "        window = Window(offset_x, offset_y, window_size, window_size)\n",
    "        \n",
    "        # Read the data for this window\n",
    "        window_data = src.read(window=window)\n",
    "        \n",
    "        # Get the profile for this window\n",
    "        window_profile = src.profile\n",
    "        window_profile.update({\n",
    "            'height': window_size,\n",
    "            'width': window_size,\n",
    "            'transform': src.window_transform(window)\n",
    "        })\n",
    "        \n",
    "    return window_data, window_profile"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read a window from the center of the image\n",
    "with rasterio.open(image_url) as src:\n",
    "    img_width, img_height = src.width, src.height\n",
    "    window_size = min(1024, img_width, img_height)  # Use smaller window if image is small\n",
    "    offset_x = (img_width - window_size) // 2\n",
    "    offset_y = (img_height - window_size) // 2\n",
    "\n",
    "print(f\"Reading window of size {window_size}x{window_size} at offset ({offset_x}, {offset_y})\")\n",
    "\n",
    "window_data, window_profile = read_image_window(image_url, window_size, offset_x, offset_y)\n",
    "print(f\"Window data shape: {window_data.shape}\")  # Should be (bands, height, width)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display the window\n",
    "def display_rgb_image(data, title=\"RGB Image\"):\n",
    "    \"\"\"\n",
    "    Display RGB image from rasterio data\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    data : numpy array\n",
    "        Image data with shape (bands, height, width)\n",
    "    title : str\n",
    "        Title for the plot\n",
    "    \"\"\"\n",
    "    # Handle different band orders\n",
    "    if data.shape[0] >= 3:\n",
    "        # Assume RGB or similar - take first 3 bands\n",
    "        rgb = data[:3, :, :]\n",
    "    else:\n",
    "        rgb = data\n",
    "    \n",
    "    # Transpose from (bands, height, width) to (height, width, bands)\n",
    "    rgb = np.transpose(rgb, (1, 2, 0))\n",
    "    \n",
    "    # Normalize for display\n",
    "    rgb = rgb.astype(float)\n",
    "    rgb = np.clip(rgb / rgb.max(), 0, 1)\n",
    "    \n",
    "    plt.figure(figsize=(12, 12))\n",
    "    plt.imshow(rgb)\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "display_rgb_image(window_data, f\"Window from {selected_item.id}\")"
   ]
