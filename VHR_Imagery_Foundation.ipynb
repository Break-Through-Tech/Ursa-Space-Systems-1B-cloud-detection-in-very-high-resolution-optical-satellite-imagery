   "source": [
    "# Display tiles in a grid\n",
    "def display_tile_grid(tiles, grid_size=3):\n",
    "    \"\"\"\n",
    "    Display tiles in a grid layout\n",
    "    \"\"\"\n",
    "    fig, axes = plt.subplots(grid_size, grid_size, figsize=(15, 15))\n",
