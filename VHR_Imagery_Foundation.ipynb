    "# Function to estimate cloud coverage from a sample window\n",
    "def estimate_cloud_coverage(url, sample_size=512, threshold=200):\n",
    "    \"\"\"\n",
    "    Estimate cloud coverage from a sample window\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    url : str\n",
    "        URL to the image file\n",
    "    sample_size : int\n",
    "        Size of sample window\n",
    "    threshold : int\n",
    "        Brightness threshold for cloud detection\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    estimated cloud coverage percentage\n",
    "    \"\"\"\n",
    "    try:\n",
    "        with rasterio.open(url) as src:\n",
    "            # Read center window\n",
    "            offset_x = (src.width - sample_size) // 2\n",
    "            offset_y = (src.height - sample_size) // 2\n",
    "            \n",
    "            window = Window(offset_x, offset_y, sample_size, sample_size)\n",
    "            data = src.read(window=window)\n",
    "            \n",
    "            # Simple cloud detection\n",
    "            if data.shape[0] >= 3:\n",
    "                rgb = data[:3, :, :]\n",
    "                brightness = np.mean(rgb, axis=0)\n",
    "            else:\n",
    "                brightness = data[0, :, :]\n",
    "            \n",
    "            cloud_mask = brightness > threshold\n",
    "            cloud_coverage = np.mean(cloud_mask) * 100\n",
    "            \n",
    "            return cloud_coverage\n",
    "    except Exception as e:\n",
    "        print(f\"Error processing {url}: {e}\")\n",
    "        return 0.0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Search for cloudy scenes across multiple collections\n",
    "def find_cloudy_scenes(catalog, num_collections=5, num_items_per_collection=5, min_cloud_coverage=20):\n",
    "    \"\"\"\n",
    "    Find scenes with significant cloud coverage\n",
